<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proceso de venta de Mapuescuela - MODELO DE REFERENCIA (BPMN 2.0, ejecutable en Flowable).

  Convenciones (mismas del ejemplo del curso INP-complementario-socios):
   - Tareas humanas   -> userTask (las completa la web via API REST de Flowable)
   - Tareas automaticas -> serviceTask flowable:type="external-worker" con topic
   - Condiciones      -> ${vars:equals(variable, valor)} con flujo default de respaldo
   - Sin pools/lanes  -> el motor no los ejecuta; los roles se manejan en la aplicacion
   - Sin seccion BPMNDiagram (DI): el diagrama visual se genera/redibuja en Flowable Design

  Variables de la instancia (se envian al iniciar el proceso desde la web):
    pedidoId (int) - clienteNombre (string) - clienteEmail (string) - montoTotal (int)
    modalidadEntrega (string: RETIRO | DESPACHO) - plazoPago (string ISO-8601, ej. PT24H)
  Variables generadas durante el proceso:
    esAprobado (boolean, la setea el voluntario) - motivoRechazo (string, opcional)
    stockOk (boolean, la setea el worker al descontar inventario)
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://mapuescuela.cl/procesos">

  <process id="ventaMapuescuela" name="Venta de artículos Mapuescuela" isExecutable="true">

    <!-- ══════════════ INICIO: la web crea el pedido en BD y arranca la instancia ══════════════ -->
    <startEvent id="startPedidoCreado" name="Pedido creado (checkout)"/>

    <sequenceFlow id="flowStartAdjuntar" sourceRef="startPedidoCreado" targetRef="utAdjuntarComprobante"/>

    <!-- ══════════════ ESPERA DEL COMPROBANTE (con plazo de 24 h) ══════════════ -->
    <userTask id="utAdjuntarComprobante" name="Adjuntar comprobante de transferencia">
      <documentation>El cliente sube el comprobante desde su página de seguimiento. La web completa
      esta tarea vía REST. Estado visible: PENDIENTE DE PAGO.</documentation>
    </userTask>

    <!-- Temporizador INTERRUPTOR: si vence el plazo, elimina la tarea y cancela el pedido -->
    <boundaryEvent id="timerPlazoPago" name="Plazo de pago vencido"
                   attachedToRef="utAdjuntarComprobante" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>${plazoPago}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <sequenceFlow id="flowTimerCancelar" sourceRef="timerPlazoPago" targetRef="ewCancelarVencido"/>

    <serviceTask id="ewCancelarVencido" name="Cancelar pedido por vencimiento"
                 flowable:type="external-worker" flowable:topic="cancelarPedidoVencido"
                 flowable:exclusive="false">
      <documentation>El worker marca el pedido CANCELADO (motivo: vencimiento). El stock nunca se
      descontó, por lo que no hay nada que devolver.</documentation>
    </serviceTask>

    <sequenceFlow id="flowVencidoEnd" sourceRef="ewCancelarVencido" targetRef="endCanceladoVencimiento"/>
    <endEvent id="endCanceladoVencimiento" name="Pedido cancelado por vencimiento"/>

    <!-- ══════════════ REVISIÓN DEL COMPROBANTE (tarea humana del voluntario) ══════════════ -->
    <sequenceFlow id="flowAdjuntarRevisar" sourceRef="utAdjuntarComprobante" targetRef="utRevisarComprobante"/>

    <userTask id="utRevisarComprobante" name="Revisar comprobante de pago">
      <documentation>El voluntario abre el archivo del comprobante y decide. Completa la tarea con
      la variable esAprobado (true/false) y motivoRechazo si corresponde. Estado: PAGO EN REVISIÓN.</documentation>
    </userTask>

    <sequenceFlow id="flowRevisarGw" sourceRef="utRevisarComprobante" targetRef="gwAprobado"/>

    <exclusiveGateway id="gwAprobado" name="¿Pago aprobado?" default="flowRechazo"/>

    <!-- Rama RECHAZO (default: si esAprobado falta o es false, jamás se aprueba por accidente) -->
    <sequenceFlow id="flowRechazo" sourceRef="gwAprobado" targetRef="ewRegistrarRechazo"/>

    <serviceTask id="ewRegistrarRechazo" name="Registrar rechazo y notificar"
                 flowable:type="external-worker" flowable:topic="registrarRechazo"
                 flowable:exclusive="false">
      <documentation>Worker: marca PAGO RECHAZADO → CANCELADO y registra la notificación para el
      cliente (visible en su página de seguimiento).</documentation>
    </serviceTask>

    <sequenceFlow id="flowRechazoEnd" sourceRef="ewRegistrarRechazo" targetRef="endCanceladoRechazo"/>
    <endEvent id="endCanceladoRechazo" name="Pedido cancelado por rechazo de pago"/>

    <!-- Rama APROBADO -->
    <sequenceFlow id="flowAprobado" sourceRef="gwAprobado" targetRef="ewDescontarInventario">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${vars:equals(esAprobado, true)}]]></conditionExpression>
    </sequenceFlow>

    <serviceTask id="ewDescontarInventario" name="Descontar inventario"
                 flowable:type="external-worker" flowable:topic="descontarInventario"
                 flowable:exclusive="false">
      <documentation>Worker → ws-pedidos (Java): descuento condicional atómico por línea
      (UPDATE ... WHERE stock >= cantidad). Devuelve la variable stockOk. Estado: PAGO APROBADO.
      Regla del caso: el stock SOLO se descuenta al aprobar el pago.</documentation>
    </serviceTask>

    <sequenceFlow id="flowInventarioGw" sourceRef="ewDescontarInventario" targetRef="gwStock"/>

    <exclusiveGateway id="gwStock" name="¿Stock disponible?" default="flowSinStock"/>

    <!-- Rama SIN STOCK (default por seguridad) -->
    <sequenceFlow id="flowSinStock" sourceRef="gwStock" targetRef="ewCancelarPorStock"/>

    <serviceTask id="ewCancelarPorStock" name="Cancelar por falta de stock"
                 flowable:type="external-worker" flowable:topic="cancelarPorStock"
                 flowable:exclusive="false">
      <documentation>Caso borde de artículos únicos: otro pedido ganó la última unidad entre la
      generación de este pedido y la aprobación del pago. Se cancela y se notifica.</documentation>
    </serviceTask>

    <sequenceFlow id="flowSinStockEnd" sourceRef="ewCancelarPorStock" targetRef="endCanceladoStock"/>
    <endEvent id="endCanceladoStock" name="Pedido cancelado por falta de stock"/>

    <!-- Rama CON STOCK → preparación -->
    <sequenceFlow id="flowConStock" sourceRef="gwStock" targetRef="utPrepararPedido">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${vars:equals(stockOk, true)}]]></conditionExpression>
    </sequenceFlow>

    <!-- ══════════════ PREPARACIÓN Y ENTREGA ══════════════ -->
    <userTask id="utPrepararPedido" name="Preparar pedido">
      <documentation>El voluntario arma el pedido. Estado: EN PREPARACIÓN.</documentation>
    </userTask>

    <sequenceFlow id="flowPrepararGw" sourceRef="utPrepararPedido" targetRef="gwModalidad"/>

    <exclusiveGateway id="gwModalidad" name="¿Modalidad de entrega?" default="flowDespacho"/>

    <!-- RETIRO en Padre Hurtado: dos pasos (queda listo → se retira) -->
    <sequenceFlow id="flowRetiro" sourceRef="gwModalidad" targetRef="utMarcarListoRetiro">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${vars:equals(modalidadEntrega, 'RETIRO')}]]></conditionExpression>
    </sequenceFlow>

    <userTask id="utMarcarListoRetiro" name="Marcar pedido listo para retiro">
      <documentation>Estado: LISTO PARA RETIRO (el cliente lo ve en su seguimiento).</documentation>
    </userTask>

    <sequenceFlow id="flowListoRetirado" sourceRef="utMarcarListoRetiro" targetRef="utRegistrarRetiro"/>

    <userTask id="utRegistrarRetiro" name="Registrar retiro del pedido">
      <documentation>El cliente retiró personalmente en Padre Hurtado.</documentation>
    </userTask>

    <sequenceFlow id="flowRetiroUnion" sourceRef="utRegistrarRetiro" targetRef="gwUnionEntrega"/>

    <!-- DESPACHO (default): registrar courier, número de seguimiento y fecha -->
    <sequenceFlow id="flowDespacho" sourceRef="gwModalidad" targetRef="utRegistrarDespacho"/>

    <userTask id="utRegistrarDespacho" name="Registrar despacho (empresa, N° seguimiento, fecha)">
      <documentation>Estado: ENVIADO. Sin integración con couriers: solo se registran los datos.</documentation>
    </userTask>

    <sequenceFlow id="flowDespachoUnion" sourceRef="utRegistrarDespacho" targetRef="gwUnionEntrega"/>

    <!-- Unión exclusiva (une caminos alternativos; NO es paralelo: solo llega uno) -->
    <exclusiveGateway id="gwUnionEntrega" name="Entrega gestionada"/>

    <sequenceFlow id="flowUnionFin" sourceRef="gwUnionEntrega" targetRef="endFinalizado"/>

    <endEvent id="endFinalizado" name="Pedido finalizado"/>

  </process>
</definitions>
