  <process id="ventaManualAsIs" name="AS-IS — Publicación y venta manual" isExecutable="true" flowable:candidateStarterGroups="flowableUser">
    <documentation>Proceso de venta manual actual de Mapuescuela, previo a la automatización:

publicación en Instagram, coordinación por WhatsApp y registro en cuaderno.</documentation>
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-08-11T00:56:15.293Z]]></design:creationdate>
      <design:description><![CDATA[Proceso de venta manual actual de Mapuescuela, previo a la automatización:

publicación en Instagram, coordinación por WhatsApp y registro en cuaderno.]]></design:description>
      <design:modificationdate><![CDATA[2026-08-26T02:38:45.554Z]]></design:modificationdate>
    </extensionElements>
    <userTask id="FormTask_5" name="Coordinación por WhatsApp (Precio, disponibilidad, entrega)" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="FormTask_7" name="Cliente transfiere y envía captura por WhatsApp" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="FormTask_1" name="Publicar producto en Instagram" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="FormTask_9" name="Revisar el pago en el chat" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="FormTask_17" name="Anotar la venta en el cuaderno" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="FormTask_19" name="Coordinar y realizar la entrega" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Exclusive_Databased_Gateway_11" name="¿Pago?" default="SequenceFlow_25">
