# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.

# ===== Flowable REST =====
FLOWABLE_BASE_URL=http://localhost:8080/flowable-rest
FLOWABLE_USER=rest-admin
FLOWABLE_PASS=CAMBIAME
FLOWABLE_PROCESS_KEY=ventaMapuescuela

# ===== Plazo de pago (ISO-8601). PT24H en producción, PT2M para demos =====
PLAZO_PAGO=PT24H

# ===== SQL Server (base de negocio) =====
DB_SERVER=localhost
DB_NAME=MAPUESCUELA_DB
DB_USER=mapuescuela_app
DB_PASS=CAMBIAME

# ===== Web service de dominio (Java) =====
WS_PEDIDOS_URL=http://localhost:9090

# ===== Datos bancarios de la organización (se muestran al cliente; JAMAS hardcodeados) =====
BANCO_NOMBRE=CAMBIAME
BANCO_TIPO_CUENTA=CAMBIAME
BANCO_NUMERO_CUENTA=CAMBIAME
BANCO_RUT_TITULAR=CAMBIAME
BANCO_EMAIL_COMPROBANTES=CAMBIAME
