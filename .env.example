# Copiar a .env y cambiar lo que haga falta. El archivo .env NUNCA se sube al repositorio.
#
# Ninguna de estas variables es obligatoria: todas tienen un valor por defecto que sirve
# para correr el proyecto en un computador. Están acá para el día que algo cambie de lugar.


# ===== El motor de Flowable =====
# Sin /service al final: cada cliente agrega lo que necesita, porque el external-job-api
# del worker cuelga de la raíz y el resto de la API va bajo /service.
FLOWABLE_BASE_URL=http://localhost:8080/flowable-rest
FLOWABLE_USER=rest-admin
FLOWABLE_PASS=test


# ===== El web service de dominio (Java) =====
WS_PEDIDOS=http://localhost:9090


# ===== Plazo para transferir, en formato ISO-8601 =====
# PT24H es el plazo real. PT2M sirve para ver el vencimiento en una demostración
# sin esperar un día.
PLAZO_PAGO=PT24H


# ===== La web =====
# Firma las cookies de sesión. Con el valor por defecto, cualquiera que conozca el
# código puede falsificar una sesión: hay que cambiarla antes de publicar esto.
SECRET_KEY=cambiame-por-algo-largo-y-aleatorio


# ===== El worker =====
WORKER_ID=worker-mapuescuela
WORKER_ESPERA=3


# La base de datos no se configura acá: H2 escribe un archivo en ws-pedidos/data/
# y no pide servidor ni credenciales.
#
# Los datos de la agrupación —dirección, correo y cuenta bancaria— tampoco: viven en
# la tabla `organizacion` y se editan desde /admin/organizacion.
